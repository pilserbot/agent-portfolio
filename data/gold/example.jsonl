{"item_id": "ex-003", "inputs": {"clause": "4.1", "text": "The contractor must hold ISO 9001 and ISO 27001 certification for the contract term."}, "expected": {"is_requirement": "yes", "certifications": ["iso-9001", "iso-27001"]}, "tags": ["requirement", "compliance"]}
