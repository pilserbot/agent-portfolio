# Copy to .env and fill in real values. .env is git-ignored; never commit real secrets.

# Anthropic API key used for the text-to-structure extraction passes.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# SQLAlchemy-style connection string for the application database.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/agent_portfolio

# Langfuse tracing credentials and endpoint.
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxxxxxxxxxx
LANGFUSE_HOST=https://cloud.langfuse.com

# Hard ceiling on model spend per day, in USD. Enforced by deterministic Python.
DAILY_SPEND_CAP_USD=10.00

# Model identifiers for the routing policy: large for hard extraction, small for the rest.
# Placeholders — set to the concrete provider model ids you are running against.
MODEL_LARGE=<large-model-id>
MODEL_SMALL=<small-model-id>
