# Copy to .env and fill in real values. .env is git-ignored; never commit real secrets.

# Anthropic API key used for the text-to-structure extraction passes.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Connection string for the application database, and for LangGraph checkpoints. When
# unset, spine.graph falls back to a local SQLite file so the sandbox works offline.
DATABASE_URL=postgresql://user:password@localhost:5432/agent_portfolio

# Where the SQLite checkpoint fallback lives. Git-ignored.
GRAPH_CHECKPOINT_PATH=.checkpoints/graph.sqlite

# Langfuse tracing credentials and endpoint. Entirely optional: with the two keys
# absent, spine.telemetry is a no-op and the project runs with no observability.
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxxxxxxxxxx
LANGFUSE_HOST=https://cloud.langfuse.com

# Hard ceiling on model spend per day, in USD. Enforced by deterministic Python in
# spine.router: a call that would breach it raises SpendCapExceeded and is never made.
DAILY_SPEND_CAP_USD=10.00

# Where spine.router persists its running daily spend total. Git-ignored.
SPEND_LEDGER_PATH=.spend/ledger.json

# Model identifiers for the routing policy: large for hard extraction, small for the rest.
# Placeholders — set to the concrete provider model ids you are running against.
MODEL_LARGE=<large-model-id>
MODEL_SMALL=<small-model-id>
