# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
sdist/
wheels/
*.egg-info/
*.egg
.eggs/

# Environments
.env
.env.*
!.env.example
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.ipynb_checkpoints/

# Evaluation reports, written into the working tree by `spine.eval.run`
eval_report.md
eval_report.json

# Adjudication queues written by ri05_tender.eval.adjudication. A queue a human has ruled
# on is worth committing; the raw output of every local run is not, so they are ignored by
# default and added deliberately with `git add -f` once the verdicts are in.
evals/adjudication/*.jsonl

# Spend ledger written by spine.router
.spend/

# LangGraph checkpoints written by the SQLite fallback
.checkpoints/

# Local databases
*.db
*.sqlite
*.sqlite3

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
