# Evaluation reports, written into the working tree by `spine.eval.run`
eval_report.md
eval_report.json

# Per-run evaluation results. The record that is kept deliberately is evals/baseline.json,
# written by `spine.eval.run --update-baseline`; these are one file per run.
evals/results/*.json

# Spend ledger written by spine.router
.spend/

# LangGraph checkpoints written by the SQLite fallback
.checkpoints/

